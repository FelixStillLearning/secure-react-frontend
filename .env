# Copy this file to .env and fill in your actual values
# DO NOT COMMIT .env TO VERSION CONTROL

# API Configuration
REACT_APP_API_URL=http://localhost:3001
REACT_APP_WS_URL=ws://localhost:3001

# Environment
REACT_APP_ENV=development

# Security Configuration (CHANGE IN PRODUCTION!)
REACT_APP_ENCRYPTION_SECRET=MediSecure2025_Dev_Key_ChangeInProd
REACT_APP_APP_NAME=MediSecure System

# Features Flags
REACT_APP_ENABLE_FINGERPRINTING=true
REACT_APP_ENABLE_RATE_LIMITING=true
REACT_APP_ENABLE_AUDIT_LOGGING=true

# Security Headers
REACT_APP_ALLOWED_HOSTS=localhost:3000,localhost:3001
REACT_APP_CSP_NONCE=dev-nonce-12345
